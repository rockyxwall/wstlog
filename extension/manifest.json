{
  "manifest_version": 3,
  "name": "ACTLog - Browser Activity Logger",
  "version": "0.0.3",
  "description": "Standalone in-browser activity logger and time tracker with clean session logs",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "idle",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5566/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
